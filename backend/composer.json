{
    "name": "herickson/task-manager-api",
    "description": "API REST para o Task Manager — PHP 8.2 + PDO + JWT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "firebase/php-jwt": "^6.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "../tests/backend/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration ../tests/backend/phpunit.xml"
    },
    "config": {
        "optimize-autoloader": true
    }
}
